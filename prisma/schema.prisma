// prisma/schema.prisma
// RoCourier - Full Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shopify Session Storage (required by @shopify/shopify-app-session-storage-prisma) ───
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── Shop Settings (one row per installed shop) ───────────────────────────────
model ShopSettings {
  id    String @id @default(cuid())
  shop  String @unique

  // ── FAN Courier ──────────────────────────────────────────────────────────────
  // Get from: selfawb.ro → Profil → Generare Token API
  fanClientId  String?   // Your client ID (numeric, e.g. "7032158")
  fanUsername  String?   // selfAWB username
  fanPassword  String?   // selfAWB password (stored encrypted in prod – see .env AES_KEY)
  fanToken     String?   // cached JWT – auto-refreshed
  fanTokenExp  DateTime?
  fanEnabled   Boolean   @default(true)

  // ── Sameday Courier ──────────────────────────────────────────────────────────
  // Get from: eawb.sameday.ro → contact software@sameday.ro for API access
  samedayUsername  String?
  samedayPassword  String?
  samedayToken     String?
  samedayTokenExp  DateTime?
  samedayEnabled   Boolean  @default(true)
  samedaySandbox   Boolean  @default(false)

  // ── Cargus Courier ──────────────────────────────────────────────────────────
  // Get from: urgentcargus.ro → contact software@urgentcargus.ro for API access
  // Subscription key from Azure API Management portal
  cargusSubscriptionKey  String?
  cargusUsername         String?
  cargusPassword         String?
  cargusEnabled          Boolean  @default(false)

  // ── GLS Romania ──────────────────────────────────────────────────────────────
  // Get from: myGLS portal (mygls.ro) → Tools → API
  glsUsername      String?
  glsPassword      String?
  glsClientNumber  String?   // GLS client number (integer, from GLS contract)
  glsShipItUrl     String?   // Deprecated — no longer used, kept for schema compatibility
  glsEnabled       Boolean  @default(false)
  glsSandbox       Boolean  @default(false)

  // ── Packeta (Zásilkovna) ─────────────────────────────────────────────────────
  // Get from: client.packeta.com → Settings → API → API password
  packetaApiKey      String?
  packetaEnabled     Boolean @default(false)
  packetaLabelFormat String  @default("A6 on A4")  // "A6 on A4" | "A6 on A6" | "A7 on A4" | "A7 on A7" | "A8 on A8"
  packetaApiPassword String?  // 32-char API password (REST); packetaApiKey is the 16-char key (feeds)
  packetaSender      String?  // "eshop" sender indication
  packetaHomeCarrierId String? // carrier id for home delivery (empty = automatic)

  // ── DPD Romania ──────────────────────────────────────────────────────────────
  // Get from: DPD Romania account manager (API user + password, same as the DPD web portal user)
  dpdUsername   String?
  dpdPassword   String?
  dpdEnabled    Boolean @default(false)
  dpdServiceId  String?   // contract service used for AWBs (empty = auto-detect)
  dpdClientId   String?   // contract client = pickup address (empty = account default)
  dpdLabelSize  String  @default("A6")  // "A6" | "A4" | "A4_4xA6"

  // ── Billing / Plan ───────────────────────────────────────────────────────────
  planType          String    @default("trial")  // "trial" | "pro_monthly" | "pro_yearly" | "lifetime"
  awbCount          Int       @default(0)         // cumulative AWBs generated (trial gate)
  shopifyChargeId   String?                       // active Shopify subscription/charge GID
  planActivatedAt   DateTime?

  // ── SmartBill ────────────────────────────────────────────────────────────────
  // Get from: app.smartbill.ro → Configurare → Tokenuri API
  smartbillEmail      String?
  smartbillToken      String?
  smartbillCompanyCIF String?  // CIF-ul firmei (ex: "RO12345678")
  smartbillSeries     String?  // Seria facturii (ex: "FACT")
  smartbillTVA        String?  @default("21")  // cota TVA implicita (%)
  smartbillCurrency   String?  @default("RON")
  smartbillEnabled    Boolean  @default(false)

  // ── Oblio ─────────────────────────────────────────────────────────────────────
  // Get from: app.oblio.eu → Setari → API
  oblioEmail          String?
  oblioSecret         String?  // client_secret din Oblio API
  oblioCIF            String?  // CIF-ul firmei
  oblioSeries         String?  // Seria facturii
  oblioTVA            String?  @default("21")
  oblioCurrency       String?  @default("RON")
  oblioEnabled        Boolean  @default(false)

  // ── FGO ───────────────────────────────────────────────────────────────────────
  // Get from: fgo.ro → Setari → Utilizatori → utilizator API (cheie privata)
  fgoCui         String?  // CUI-ul firmei (fara RO)
  fgoPrivateKey  String?
  fgoSeries      String?
  fgoTVA         String?  @default("21")
  fgoCurrency    String?  @default("RON")
  fgoEnabled     Boolean  @default(false)
  fgoSandbox     Boolean  @default(false)

  // ── Invoicing Settings (common) ──────────────────────────────────────────────
  invoiceProvider        String?  // "smartbill" | "oblio" | "fgo" | null
  autoSendInvoice        Boolean  @default(false)  // trimite factura dupa creare comanda
  autoInvoiceOnFulfill   Boolean  @default(false)  // trimite factura la fulfillment

  // ── xConnector Note ──────────────────────────────────────────────────────────
  // xConnector is a separate Shopify App (by InfoQuest, apps.shopify.com/xconnector)
  // Your app can PUSH order data to xConnector via Shopify Order metafields/notes,
  // which xConnector reads. Direct API key below is for their future partner API.
  xconnectorApiKey  String?
  xconnectorEnabled Boolean  @default(false)

  // ── Sender / Warehouse Info ──────────────────────────────────────────────────
  senderName    String?
  senderCity    String?
  senderZip     String?
  senderAddress String?
  senderPhone   String?
  senderEmail   String?
  senderCounty  String?  @default("Bucuresti")

  // ── Onboarding ───────────────────────────────────────────────────────────────
  onboardingCompleted Boolean  @default(false)

  // ── App Settings ─────────────────────────────────────────────────────────────
  defaultWeight      Float    @default(1.0)  // kg
  defaultCourier     String   @default("fan") // "fan" | "sameday"
  autoGenerateAwb    Boolean  @default(false)
  widgetPosition     String   @default("before_checkout") // position in cart
  codSurcharge       Float    @default(0)   // extra fee for COD orders
  showPickupMap      Boolean  @default(true)
  widgetLanguage     String   @default("auto") // "auto" | "ro" | "en" | "de" | "hu" | "cs"

  // ── Shipping fees (in RON, displayed and charged via carrier service) ─────────
  fanHomeDeliveryFee       Float  @default(0)
  fanPickupFee             Float  @default(0)
  samedayHomeDeliveryFee   Float  @default(0)
  samedayPickupFee         Float  @default(0)
  cargusHomeDeliveryFee    Float  @default(0)
  cargusPickupFee          Float  @default(0)
  glsHomeDeliveryFee       Float  @default(0)
  glsPickupFee             Float  @default(0)
  packetaHomeDeliveryFee   Float  @default(0)
  packetaPickupFee         Float  @default(0)
  dpdHomeDeliveryFee       Float  @default(0)
  dpdPickupFee             Float  @default(0)

  // ── Cart widget extras ───────────────────────────────────────────────────
  freeShippingThreshold  Float?             // cart total for free delivery (null = off)
  freeShippingScope      String  @default("all")  // all | pickup (free only to lockers)
  showDeliveryEstimate   Boolean @default(true)
  dispatchCutoffHour     Int     @default(14)      // orders after this hour leave next working day
  processingDays         Int     @default(0)       // extra working days to pack an order

  // ── Order checks ─────────────────────────────────────────────────────────
  validateAddresses      Boolean @default(true)    // flag bad zip/city/phone before the AWB
  refusalWarnThreshold   Int     @default(1)       // warn when the customer refused this many parcels
  blockCodAfterRefusals  Int     @default(0)       // hide cash on delivery at checkout after N refusals (0 = off)

  // ── Support ──────────────────────────────────────────────────────────────
  supportAccess          Boolean @default(true)    // Picklo team may view and change this store's Picklo setup
  routingRules           Json?                     // [{ when: {...}, courier }] evaluated in order

  // ── Returns ──────────────────────────────────────────────────────────────
  returnsEnabled         Boolean @default(false)
  returnsWindowDays      Int     @default(14)
  returnsCourier         String?                   // courier used for return AWBs
  returnsInstructions    String?

  // ── COD reconciliation ───────────────────────────────────────────────────
  codSyncedAt            DateTime?

  // ── Checkout delivery options ────────────────────────────────────────────
  // "ccs" = Shopify asks Picklo for rates (carrier-calculated shipping available)
  // "manual" = store has no CCS; Picklo-created fixed rates + cart widget
  checkoutMode        String?  // null until detected

  // ── Automations (all off by default) ─────────────────────────────────────
  autoAwbFilter          String  @default("all")  // all | cod | paid | pickup
  autoAwbMarkShipped     Boolean @default(false)
  autoAwbNotifyCustomer  Boolean @default(false)
  autoInvoiceOnDelivered Boolean @default(false)  // invoice when the courier confirms delivery
  onCancelDeleteAwb      Boolean @default(false)  // Shopify order cancelled → delete AWB (+ cancel fulfillment)
  onCancelInvoice        String  @default("none") // none | cancel | reverse
  onRefundReverseInvoice Boolean @default(false)  // fully refunded → storno
  onDeliveredMarkPaid    Boolean @default(false)  // COD delivered → mark paid in Shopify + collect invoice
  onReturnedCancelOrder  Boolean @default(false)  // returned/refused → cancel order in Shopify (restock)
  onReturnedInvoice      String  @default("none") // none | cancel | reverse
  statusTags             Boolean @default(false)  // picklo-* tags on Shopify orders
  copyCustomerPhone      Boolean @default(false)  // fill missing shipping phone from customer/billing
  checkoutLockerCount Int      @default(5) // nearest lockers offered as rates in CCS mode

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Activity log (who did what, when) ─────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  shop      String
  orderId   String?
  orderName String?
  action    String   // awb_generated | awb_deleted | invoice_issued | return_requested | cod_reconciled …
  message   String
  actor     String?  // "automation" | staff email | "customer"
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([orderId])
}

// ─── Return requests (customer portal) ─────────────────────────────────────────
model ReturnRequest {
  id               String   @id @default(cuid())
  shop             String
  orderId          String
  shopifyOrderName String
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  items            Json     // [{ name, sku, quantity }]
  reason           String
  comment          String?
  method           String   @default("courier")  // courier (pickup from address) | locker | dropoff
  pickupPointId    String?
  pickupPointName  String?
  iban             String?
  status           String   @default("requested") // requested | approved | rejected | awb_generated | received | refunded
  returnCourier    String?
  returnAwbNumber  String?
  dropoffPassword  String?  // Packeta returns: code the customer gives at the drop-off point
  merchantNote     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, status])
  @@index([orderId])
}

// ─── COD payouts reported by couriers (ramburs) ────────────────────────────────
model CodPayout {
  id          String   @id @default(cuid())
  shop        String
  courier     String
  awbNumber   String
  amount      Float
  currency    String   @default("RON")
  paidAt      DateTime?
  documentId  String?
  orderId     String?   // matched Picklo order
  createdAt   DateTime @default(now())

  @@unique([shop, courier, awbNumber])
  @@index([shop, paidAt])
}

// ─── Orders (synced from Shopify via webhook) ─────────────────────────────────
model Order {
  id   String @id @default(cuid())
  shop String

  // Shopify data
  shopifyOrderId    String
  shopifyOrderName  String   // e.g. "#38952"
  shopifyOrderToken String?

  // Customer
  customerName    String?
  customerPhone   String?
  customerEmail   String?

  // Shipping address
  shippingAddress1 String?
  shippingCity     String?
  shippingCounty   String?
  shippingZip      String?
  shippingCountry  String?  @default("RO")

  // Delivery choice (set by cart widget)
  shippingMethod    String   @default("home_delivery") // "home_delivery" | "pickup_point"
  courierType       String   @default("fan")           // "fan" | "sameday"
  pickupPointId     String?
  pickupPointName   String?
  pickupPointAddress String?

  // AWB
  awbNumber   String?
  awbPdfUrl   String?
  awbStatus   String   @default("pending")
  // Statuses: pending → generated → picked_up → in_transit → out_for_delivery → delivered | returned | failed

  // Financials
  codAmount     Float   @default(0)
  orderTotal    Float   @default(0)
  weight        Float   @default(1)
  packageCount  Int     @default(1)

  // Invoice (SmartBill / Oblio) — kept so it can be cancelled, reversed or collected later
  invoiceProvider   String?   // "smartbill" | "oblio"
  invoiceSeries     String?
  invoiceNumber     String?
  invoiceUrl        String?
  invoiceStatus     String?   // "issued" | "cancelled" | "reversed" | "collected"
  invoiceReverseNumber String? // storno document number
  invoiceIssuedAt   DateTime?
  financialStatus   String?   // Shopify financial status (paid, pending, refunded…)
  shopifyCancelledAt DateTime?

  // B2B (company on the order) — invoices go to the company
  customerCompany  String?
  customerVatCode  String?
  customerRegCom   String?

  // Shipping cost charged by the courier for this AWB (when the API returns it)
  shippingCost     Float?
  deliveredAt      DateTime?

  // COD reconciliation — money transferred by the courier
  codCollectedAmount Float?
  codCollectedAt     DateTime?
  codPayoutRef       String?

  // xConnector sync status
  xconnectorSynced  Boolean  @default(false)
  xconnectorSyncAt  DateTime?

  // Timestamps
  shopifyCreatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // AWB events log
  events AwbEvent[]

  @@unique([shop, shopifyOrderId])
  @@index([shop])
  @@index([shop, awbStatus])
  @@index([shop, courierType])
  @@index([shop, customerPhone])
  @@index([createdAt])
}

// ─── AWB Tracking Events ──────────────────────────────────────────────────────
model AwbEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventCode String
  eventDesc String
  eventDate DateTime
  location  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─── Pickup Points Cache (refreshed every 24h) ───────────────────────────────
model PickupPoint {
  id         String @id @default(cuid())
  externalId String  // ID from courier API
  courier    String  // "fan" | "sameday" | "cargus" | "gls" | "packeta" | "dpd"
  name       String
  address    String
  city       String?
  county     String?
  zip        String?
  country    String? @default("ro")  // ISO 3166-1 alpha-2 lowercase
  lat        Float?
  lng        Float?
  type       String?  // "fanbox" | "easybox" | "pudo" | "packeta_point" | "zbox"
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([courier, externalId])
  @@index([courier])
  @@index([county])
  @@index([country])
  @@index([country, lat, lng])
  @@index([country, zip])
}

// ─── Discount Codes ───────────────────────────────────────────────────────────
model DiscountCode {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  type       String   // "lifetime_gift" | "percent"
  percentOff Int?     // e.g. 20 = 20% off (only for "percent" type)
  maxUses    Int?     // null = unlimited
  usedCount  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  usages     DiscountCodeUsage[]
}

model DiscountCodeUsage {
  id           Int          @id @default(autoincrement())
  code         String
  shop         String
  usedAt       DateTime     @default(now())
  discountCode DiscountCode @relation(fields: [code], references: [code])

  @@unique([code, shop])
}

// ─── Support tickets (merchant ↔ Picklo team) ──────────────────────────────────
model SupportTicket {
  id              String   @id @default(cuid())
  shop            String
  subject         String
  category        String   @default("question") // question | problem | setup | billing | feature
  status          String   @default("open")     // open | waiting_merchant | resolved
  priority        String   @default("normal")   // low | normal | high | urgent
  contactName     String?
  contactEmail    String?
  assignedTo      String?                         // TeamMember email
  unreadByTeam    Boolean  @default(true)
  unreadByMerchant Boolean @default(false)
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        SupportMessage[]

  @@index([shop, status])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     String   // merchant | team
  authorName String?
  body       String
  internal   Boolean  @default(false) // team-only note, never shown to the merchant
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ─── Picklo team accounts for the /hq dashboard ────────────────────────────────
model TeamMember {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("support") // admin | support
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}
