{% comment %}
  Picklo — shipping selector on the cart page
  No <input> elements — pure div/button UI to avoid Shopify cart section re-renders
{% endcomment %}

{% render 'picklo-widget', s: block.settings %}

<link rel="stylesheet" href="{{ 'leaflet.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'MarkerCluster.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'MarkerCluster.Default.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'rocourier.css' | asset_url }}">
<script src="{{ 'leaflet.js' | asset_url }}" defer></script>
<script src="{{ 'leaflet.markercluster.js' | asset_url }}" defer></script>
<script src="{{ 'rocourier.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Picklo Shipping",
  "target": "section",
  "settings": [
    { "type": "header",   "content": "Aspect widget" },
    { "type": "color",    "id": "primary_color",      "label": "Culoare principală",   "default": "#222222" },
    { "type": "color",    "id": "widget_bg",          "label": "Fundal widget",        "default": "#ffffff" },
    { "type": "color",    "id": "border_color",       "label": "Culoare bordură",      "default": "#e0e0e0" },
    { "type": "select",   "id": "border_radius",      "label": "Colțuri",
      "options": [
        { "value": "sharp",   "label": "Drepte (0px)" },
        { "value": "rounded", "label": "Rotunjite (10px)" },
        { "value": "pill",    "label": "Pill (24px)" }
      ],
      "default": "rounded"
    },
    { "type": "select",   "id": "widget_padding",     "label": "Spațiu interior (padding)",
      "options": [
        { "value": "none",   "label": "Fără (0px)" },
        { "value": "small",  "label": "Mic (8px)" },
        { "value": "medium", "label": "Mediu (16px)" },
        { "value": "large",  "label": "Mare (24px)" }
      ],
      "default": "none"
    },
    { "type": "checkbox", "id": "show_title",         "label": "Afișează titlul secțiunii", "default": true },
    { "type": "text",     "id": "title",              "label": "Titlu secțiune",       "default": "Metoda de livrare:" },
    { "type": "text",     "id": "search_placeholder", "label": "Placeholder căutare",  "default": "Oraș, cod poștal, adresă..." },
    { "type": "header",   "content": "Curieri în coș" },
    { "type": "paragraph", "content": "Datele de cont și prețurile se setează în aplicația Picklo. Aici alegi doar unde apare fiecare curier configurat acolo." },
    { "type": "select",   "id": "fan_mode", "label": "FAN Courier", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] },
    { "type": "select",   "id": "sameday_mode", "label": "Sameday", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] },
    { "type": "select",   "id": "cargus_mode", "label": "Cargus", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] },
    { "type": "select",   "id": "gls_mode", "label": "GLS", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] },
    { "type": "select",   "id": "packeta_mode", "label": "Packeta", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] },
    { "type": "select",   "id": "dpd_mode", "label": "DPD", "default": "both", "options": [{ "value": "both", "label": "Acasă și locker" }, { "value": "home", "label": "Doar livrare acasă" }, { "value": "pickup", "label": "Doar locker / punct" }, { "value": "off", "label": "Ascuns" }] }
  ]
}
{% endschema %}
