{% comment %}
  Picklo — the same delivery widget as the cart page block, for cart drawers. The markup sits in
  a <template>; rocourier.js places it above the drawer's checkout button and places it again
  whenever the theme re-renders the drawer.
{% endcomment %}

<template id="picklo-drawer-template"
  data-anchor="{{ block.settings.anchor_selector | escape }}"
  data-cart-page="{{ block.settings.cart_page }}">
  {% render 'picklo-widget', s: block.settings %}
</template>

<link rel="stylesheet" href="{{ 'leaflet.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'MarkerCluster.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'MarkerCluster.Default.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'rocourier.css' | asset_url }}">
<script src="{{ 'leaflet.js' | asset_url }}" defer></script>
<script src="{{ 'leaflet.markercluster.js' | asset_url }}" defer></script>
<script src="{{ 'rocourier.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Picklo în coșul glisant",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "Unde apare"
    },
    {
      "type": "paragraph",
      "content": "Widgetul se pune singur deasupra butonului de checkout din coșul glisant, la fel ca în pagina coșului. Dacă tema ta are alt coș, scrie mai jos selectorul elementului înaintea căruia să apară."
    },
    {
      "type": "text",
      "id": "anchor_selector",
      "label": "Selector CSS (opțional)",
      "info": "Ex.: .cart-drawer__footer .cart__ctas. Gol = automat."
    },
    {
      "type": "checkbox",
      "id": "cart_page",
      "label": "Pune-l și în pagina coșului, dacă nu ai adăugat acolo blocul Picklo",
      "default": true
    },
    {
      "type": "header",
      "content": "Aspect widget"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Culoare principală",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "widget_bg",
      "label": "Fundal widget",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Culoare bordură",
      "default": "#e0e0e0"
    },
    {
      "type": "select",
      "id": "border_radius",
      "label": "Colțuri",
      "options": [
        {
          "value": "sharp",
          "label": "Drepte (0px)"
        },
        {
          "value": "rounded",
          "label": "Rotunjite (10px)"
        },
        {
