{%- comment -%}
  Picklo delivery widget: home / pickup point rows and the locker map. Shared by the cart page
  block (blocks/shipping-selector.liquid) and the cart drawer embed (blocks/cart-drawer.liquid),
  so both run the same rocourier.js. Pass the block settings as `s`.
{%- endcomment -%}
{%- assign rc_padding_map = s.widget_padding | default: 'none' -%}
{%- if rc_padding_map == 'small' -%}{%- assign rc_padding = '8px' -%}
{%- elsif rc_padding_map == 'medium' -%}{%- assign rc_padding = '16px' -%}
{%- elsif rc_padding_map == 'large' -%}{%- assign rc_padding = '24px' -%}
{%- else -%}{%- assign rc_padding = '0px' -%}
{%- endif -%}

<div
  id="rocourier-widget"
  class="rocourier-widget"
  style="padding: {{ rc_padding }};"
  data-shop="{{ shop.permanent_domain }}"

  data-currency="{{ cart.currency.iso_code | default: 'RON' }}"
  data-lang="{{ request.locale.iso_code | slice: 0, 2 | downcase }}"
  data-country="{{ localization.country.iso_code | downcase | default: 'ro' }}"
  data-fan-mode="{{ s.fan_mode | default: 'both' }}"
  data-fan-logo="{{ 'logo-fan.svg' | asset_url }}"
  data-fan-pin="{{ 'pin-fan.png' | asset_url }}"
  data-sameday-mode="{{ s.sameday_mode | default: 'both' }}"
  data-sameday-logo="{{ 'logo-sameday.svg' | asset_url }}"
  data-sameday-pin="{{ 'pin-sameday.png' | asset_url }}"
  data-cargus-mode="{{ s.cargus_mode | default: 'both' }}"
  data-cargus-logo="{{ 'logo-cargus.svg' | asset_url }}"
  data-cargus-pin="{{ 'pin-cargus.png' | asset_url }}"
  data-gls-mode="{{ s.gls_mode | default: 'both' }}"
  data-gls-logo="{{ 'logo-gls.svg' | asset_url }}"
  data-gls-pin="{{ 'pin-gls.png' | asset_url }}"
  data-packeta-mode="{{ s.packeta_mode | default: 'both' }}"
  data-packeta-logo="{{ 'logo-packeta.svg' | asset_url }}"
  data-packeta-pin="{{ 'pin-packeta.png' | asset_url }}"
  data-dpd-mode="{{ s.dpd_mode | default: 'both' }}"
  data-dpd-logo="{{ 'logo-dpd.svg' | asset_url }}"
  data-dpd-pin="{{ 'pin-dpd.png' | asset_url }}"
>

  {%- if s.show_title != false -%}
  <p class="rc-section-title" id="rc-section-title">
    {{ s.title | default: 'Metoda de livrare:' }}
  </p>
  {%- endif -%}

  <div id="rc-free-bar" class="rc-free-bar" hidden>
    <span id="rc-free-text" class="rc-free-text"></span>
    <span class="rc-free-track"><span id="rc-free-fill" class="rc-free-fill"></span></span>
  </div>

  <div class="rc-methods" role="radiogroup" aria-label="Metoda de livrare">

    <!-- ── HOME DELIVERY row ───────────────────────────────────────────── -->
    <div class="rc-method-row" id="rc-home-row" role="radio" aria-checked="false" tabindex="0" data-rc-value="home">
      <span class="rc-method-icon rc-icon-home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24" style="width:24px;height:24px;min-width:24px;max-width:24px;flex-shrink:0;">
          <rect x="1" y="3" width="15" height="13" rx="1"/>
          <path d="M16 8h4l3 5v3h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </span>
      <span class="rc-method-text">
        <strong id="rc-home-label">Livrare la domiciliu</strong>
        <small id="rc-home-sub">Livrare standard la adresă</small>
      </span>
      <span id="rc-home-fee" class="rc-method-fee"></span>
      <span class="rc-method-radio"></span>
    </div>

    <!-- ── PICKUP POINT row ────────────────────────────────────────────── -->
    <div class="rc-method-row rc-row-last" id="rc-pickup-row" role="radio" aria-checked="false" tabindex="0" data-rc-value="pickup">
      <span class="rc-method-icon rc-icon-box">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24" style="width:24px;height:24px;min-width:24px;max-width:24px;flex-shrink:0;">
          <rect x="2" y="3" width="20" height="18" rx="2"/>
          <line x1="2" y1="9" x2="22" y2="9"/>
          <line x1="12" y1="9" x2="12" y2="21"/>
        </svg>
      </span>
      <span class="rc-method-text">
        <strong id="rc-pickup-label">Ridicare din punct fix</strong>
        <small id="rc-pickup-sub">Locker, easybox, ParcelShop...</small>
      </span>
      <span id="rc-pickup-fee" class="rc-method-fee"></span>
      <span class="rc-method-radio"></span>
    </div>

  </div>

  <!-- Selected pickup point summary -->
  <div id="rc-point-selected" class="rc-point-selected" style="display:none;">
    <img id="rc-point-logo" class="rc-point-logo" src="" alt="" width="60" height="20">
    <div class="rc-point-info">
      <strong id="rc-point-name"></strong>
      <span id="rc-point-addr"></span>
    </div>
    <button type="button" id="rc-change-point" class="rc-change-btn"><!-- translated by JS --></button>
  </div>

  <p id="rc-eta" class="rc-eta" hidden></p>

  <div id="rc-error" class="rc-error" style="display:none;"></div>

</div>

{%- comment -%} MAP MODAL {%- endcomment -%}
<div id="rc-modal" class="rc-modal" style="display:none;" role="dialog" aria-modal="true">
  <div class="rc-modal-backdrop" id="rc-modal-backdrop"></div>
  <div class="rc-modal-inner">

    <!-- Map panel — fills space above the bottom sheet -->
    <div class="rc-map-panel" id="rc-map-panel">
      <div id="rc-map"></div>
      <button type="button" id="rc-modal-close" class="rc-modal-close" aria-label="Close">✕</button>
    </div>

    <!-- Bottom sheet — draggable on mobile, side panel on desktop -->
    <div class="rc-bottom-sheet" id="rc-bottom-sheet">
      <!-- Drag handle (mobile only) -->
      <div class="rc-sheet-handle" id="rc-sheet-handle">
        <div class="rc-sheet-pill"></div>
      </div>

      <!-- Search + filter toggle -->
      <div class="rc-sheet-header">
        <div class="rc-modal-search-wrap">
          <svg class="rc-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            id="rc-search"
            class="rc-search-input"
            placeholder="{{ s.search_placeholder | default: 'Oraș, cod poștal, adresă...' }}"
            autocomplete="off"
          >
        </div>
        <button type="button" class="rc-filter-toggle" id="rc-filter-toggle" aria-label="Filters">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
        </button>
      </div>

      <!-- Courier filter chips -->
      <div class="rc-modal-filters" id="rc-type-filters">
        <button type="button" class="rc-filter-btn rc-filter-active" id="rc-filter-all" data-courier="all">Toate</button>
        {%- if s.fan_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="fan">
            <img src="{{ 'logo-fan.svg' | asset_url }}" alt="FAN" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
        {%- if s.sameday_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="sameday">
            <img src="{{ 'logo-sameday.svg' | asset_url }}" alt="Sameday" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
        {%- if s.cargus_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="cargus">
            <img src="{{ 'logo-cargus.svg' | asset_url }}" alt="Cargus" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
        {%- if s.gls_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="gls">
            <img src="{{ 'logo-gls.svg' | asset_url }}" alt="GLS" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
        {%- if s.packeta_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="packeta">
            <img src="{{ 'logo-packeta.svg' | asset_url }}" alt="Packeta" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
        {%- if s.dpd_mode != 'off' -%}
          <button type="button" class="rc-filter-btn" data-courier="dpd">
            <img src="{{ 'logo-dpd.svg' | asset_url }}" alt="DPD" class="rc-filter-logo" width="48" height="16">
          </button>
        {%- endif -%}
      </div>

      <!-- Scrollable list -->
      <div class="rc-sheet-body">
        <div id="rc-list-loading" class="rc-list-loading">
          <div class="rc-spinner"></div>
          <span id="rc-loading-text">Se încarcă punctele de ridicare...</span>
        </div>
        <div id="rc-list-empty" style="display:none;" class="rc-list-empty"><!-- translated by JS --></div>
        <ul id="rc-points-list" class="rc-points-list"></ul>
        <div id="rc-list-count" class="rc-list-count" style="display:none;"></div>
      </div>
    </div>

  </div>
</div>

{%- comment -%} Theme customisation — injected as CSS custom properties {%- endcomment -%}
{%- assign rc_radius_map = s.border_radius | default: 'rounded' -%}
{%- if rc_radius_map == 'sharp' -%}{%- assign rc_radius = '0px' -%}
{%- elsif rc_radius_map == 'pill' -%}{%- assign rc_radius = '24px' -%}
{%- else -%}{%- assign rc_radius = '10px' -%}
{%- endif -%}
<style>
  #rocourier-widget,
  #rocourier-widget ~ *,
  #rc-modal {
    --rc-primary:    {{ s.primary_color | default: '#222222' }};
    --rc-bg:         {{ s.widget_bg     | default: '#ffffff' }};
    --rc-border:     {{ s.border_color  | default: '#e0e0e0' }};
    --rc-radius:     {{ rc_radius }};
  }
</style>
